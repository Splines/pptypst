{
    "compilerOptions": {
        "target": "es2021",
        "module": "esnext",
        "lib": [
            "ES2021"
        ],
        // The script context's globals (api/cavalry/ui). The JS Shape sandbox
        // has a different, smaller set -- `src/plugin/shape.ts` pulls the extra
        // `ctx` declarations in itself.
        "types": [
            "@scenery/cavalry-types"
        ],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "useDefineForClassFields": true,
        "strict": true,
        "strictNullChecks": true,
        "sourceMap": false,
        "resolveJsonModule": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts"
    ]
}
